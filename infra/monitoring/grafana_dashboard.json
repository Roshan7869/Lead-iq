{
  "__inputs": [],
  "__requires": [],
  "title": "LeadIQ Pipeline Overview",
  "uid": "leadiq-pipeline",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["leadiq", "pipeline"],
  "panels": [
    {
      "id": 1,
      "title": "Leads Collected Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(leads_collected_total[5m])",
          "legendFormat": "{{source}}",
          "interval": "15s"
        }
      ],
      "description": "Rate of leads collected per second, broken down by source.",
      "xaxis": { "mode": "time", "show": true },
      "yaxes": [
        { "format": "ops", "label": "Leads / sec", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true }
    },
    {
      "id": 2,
      "title": "Scoring Accuracy",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "avg(scoring_accuracy_percent) / 100",
          "legendFormat": "Accuracy"
        }
      ],
      "description": "Current scoring accuracy against ground truth (0-100%).",
      "options": {
        "min": 0,
        "max": 1,
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 0.6 },
          { "color": "yellow", "value": 0.75 },
          { "color": "green", "value": 0.9 }
        ]
      }
    },
    {
      "id": 3,
      "title": "Pipeline Latency (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}",
          "interval": "15s"
        }
      ],
      "description": "95th percentile latency per pipeline stage.",
      "xaxis": { "mode": "time", "show": true },
      "yaxes": [
        { "format": "s", "label": "Latency (seconds)", "show": true },
        { "format": "short", "show": false }
      ],
      "legend": { "show": true, "alignAsTable": true }
    },
    {
      "id": 4,
      "title": "Source Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by(source) (leads_collected_total)",
          "legendFormat": "{{source}}"
        }
      ],
      "description": "Breakdown of leads by data source.",
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": { "show": true }
      }
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(pipeline_errors_total[5m])",
          "legendFormat": "Errors / sec"
        }
      ],
      "description": "Current pipeline error rate per second.",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["mean"],
          "values": false
        },
        "textMode": "auto"
      },
      "thresholds": [
        { "color": "green", "value": null },
        { "color": "orange", "value": 0.01 },
        { "color": "red", "value": 0.1 }
      ]
    },
    {
      "id": 6,
      "title": "Band Distribution",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "sum by(band) (leads_scored_total)",
          "legendFormat": "{{band}}"
        }
      ],
      "description": "Count of leads per scoring band (hot, warm, cool, cold).",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "thresholds": [
        { "color": "red", "value": null },
        { "color": "orange", "value": 10 },
        { "color": "yellow", "value": 50 },
        { "color": "green", "value": 100 }
      ]
    }
  ],
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["15s", "30s", "1m", "5m", "15m", "30m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "schemaVersion": 38,
  "style": "dark"
}
