  "data_flow": {
    "pipeline": [
      {"step": 1, "stage": "COLLECT", "component": "Collectors", "action": "Scrape 24 sources → RawPost", "output": "Post table"},
      {"step": 2, "stage": "DEDUP", "component": "dedup_service.py", "action": "3-tier dedup (exact → fuzzy → vector)", "output": "Deduplicated posts"},
      {"step": 3, "stage": "EXTRACT", "component": "llm/gemini_service.py", "action": "extract_lead() with source-specific prompt", "output": "Lead record"},
      {"step": 4, "stage": "ANALYZE", "component": "workers/analyzer.py", "action": "7-stage waterfall analysis", "output": "lead:analyzed stream"},
      {"step": 5, "stage": "SCORE", "component": "workers/scorer.py", "action": "composite score = 0.40×intent + 0.30×icp_fit + 0.20×velocity + 0.10×network", "output": "lead:scored stream"},
      {"step": 6, "stage": "RANK", "component": "services/*", "action": "temporal_decay + icp_scorer + feedback_loop + velocity_bonus", "output": "lead:ranked stream"},
      {"step": 7, "stage": "OUTREACH", "component": "personalization.py + outreach_rag.py", "action": "Generate outreach draft, quality gate ≥7.0/10", "output": "lead:outreach stream"},
      {"step": 8, "stage": "CRM", "component": "pipeline_service.py", "action": "Push to external CRM", "output": "lead:crm_update stream"}
    ],
    "feedback_loop": [
      {"step": 1, "component": "User", "action": "approve/reject/edit lead"},
      {"step": 2, "component": "LeadEvent model", "action": "Log event to lead_events table"},
      {"step": 3, "component": "feedback_loop.py", "action": "Adjust lead scores based on feedback"},
      {"step": 4, "component": "icp_scorer.py", "action": "Retrain logistic regression weights"}
    ]
